# ------------------------------------------------------------
# .env.example → .env 로 복사한 뒤 값을 수정하세요.
#   cp .env.example .env        (install 스크립트가 자동 수행)
# .env 는 .gitignore 대상이므로 절대 커밋하지 않습니다.
# ------------------------------------------------------------

# Project
TZ=Asia/Seoul

# ---------- 이미지 버전 (폐쇄망 반입 이미지와 반드시 일치) ----------
N8N_VERSION=2.41.3
POSTGRES_VERSION=17-alpine
QDRANT_VERSION=v1.19.1
OLLAMA_VERSION=0.35.0
FRONTEND_VERSION=local

# ---------- 외부 노출 포트 ----------
FRONTEND_PORT=8080
N8N_PORT=5678
# 아래 두 포트는 127.0.0.1 에만 바인딩됩니다 (개발·디버깅용)
QDRANT_PORT=6333
OLLAMA_PORT=11434

# ---------- n8n ----------
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
# 자격증명 암호화 키. 한 번 정한 뒤 바꾸면 저장된 Credential 을 읽지 못합니다.
# install 스크립트가 CHANGE_ME 인 경우 임의 값으로 자동 생성합니다.
N8N_ENCRYPTION_KEY=CHANGE_ME

# ---------- PostgreSQL (n8n 영속 DB) ----------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# install 스크립트가 CHANGE_ME 인 경우 임의 값으로 자동 생성합니다.
POSTGRES_PASSWORD=CHANGE_ME

# ---------- RAG ----------
QDRANT_COLLECTION=knowledge_base
# 임베딩 모델: 한국어 지원 다국어 모델 (1024차원)
OLLAMA_EMBED_MODEL=bge-m3
# 답변 생성 모델: CPU 환경 기준 경량 모델. GPU 가 있으면 qwen2.5:7b 등으로 변경
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
# 모델 컨텍스트 길이(토큰). 검색 청크 수(topK)를 늘리면 함께 늘린다
OLLAMA_CONTEXT_LENGTH=8192
# 청크 크기(문자 수)와 겹침
CHUNK_SIZE=800
CHUNK_OVERLAP=100
